# ========================================
# Variáveis de Ambiente - MongoDB PokeAPI
# ========================================
# Este arquivo serve como template para configuração das variáveis de ambiente.
# Para usar em produção:
#   1. Copie este arquivo: cp .env.example .env
#   2. Edite o arquivo .env com suas credenciais reais
#   3. Adicione .env ao .gitignore (nunca commite senhas!)

# ========================================
# MongoDB - Usuário Root
# ========================================
# Credenciais do usuário administrador root do MongoDB
# Este usuário é criado automaticamente na primeira inicialização
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin

# ========================================
# MongoDB - Banco de Dados Inicial
# ========================================
# Nome do banco de dados que será inicializado
# Os scripts em init-db/ serão executados neste contexto
MONGO_INITDB_DATABASE=pokeAPI

# ========================================
# Mongo Express - Interface Web
# ========================================
# Credenciais para acessar o Mongo Express (http://localhost:8081)
ME_CONFIG_MONGODB_ADMINUSERNAME=admin
ME_CONFIG_MONGODB_ADMINPASSWORD=admin
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=admin

# ========================================
# Portas dos Serviços
# ========================================
# Porta do MongoDB (padrão: 27017)
MONGODB_PORT=27017

# Porta do Mongo Express (padrão: 8081)
MONGO_EXPRESS_PORT=8081

# ========================================
# Usuários da Aplicação (para referência)
# ========================================
# Estes usuários são criados pelos scripts de inicialização
# As senhas abaixo são apenas para documentação - NÃO são usadas no .env

# appAdmin - Administrador completo da aplicação
# Senha padrão: adminPass123

# viewer - Usuário somente leitura
# Senha padrão: viewPass123

# dataEntry - usuário para entrada de dados
# Senha padrão: entryPass123

# analyst - Analista de dados com acesso a estatísticas
# Senha padrão: analystPass123

# restrictedUser - Acesso restrito à coleção pokemons
# Senha padrão: restrictPass123

# developer - Desenvolvedor com leitura e escrita
# Senha padrão: devPass123

# ========================================
# NOTAS DE SEGURANÇA
# ========================================
# ⚠️ IMPORTANTE - PRODUÇÃO:
# 1. Use senhas fortes (mínimo 16 caracteres)
# 2. Use geradores de senha aleatórios
# 3. Nunca exponha suas credenciais em repositórios públicos
# 4. Use Docker Secrets ou ferramentas como HashiCorp Vault
# 5. Habilite SSL/TLS para conexões MongoDB
# 6. Configure firewall para limitar acesso às portas
# 7. Use autenticação via certificados quando possível
# 8. Rotacione senhas periodicamente

# Exemplo de senha forte:
# MONGO_INITDB_ROOT_PASSWORD=X7$mK9@pL2#nQ5&wR8^tY4!uI6*oP3

# ========================================
# Como usar arquivo .env com Docker Compose
# ========================================
# 1. Copie este arquivo para .env
# 2. Edite as variáveis no arquivo .env
# 3. As variáveis serão carregadas automaticamente pelo docker-compose
# 4. No docker-compose.yml, referencie como: ${NOME_DA_VARIAVEL}
