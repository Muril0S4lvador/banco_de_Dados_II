# ========================================
# Variáveis de Ambiente - MongoDB PokeAPI
# ========================================
# Este arquivo serve como template para configuração das variáveis de ambiente.
# Para usar em produção:
#   1. Copie este arquivo: cp .env.example .env
#   2. Edite o arquivo .env com suas credenciais reais
#   3. Adicione .env ao .gitignore (nunca commite senhas!)

# ========================================
# MongoDB - Usuário Root
# ========================================
# Credenciais do usuário administrador root do MongoDB
# Este usuário é criado automaticamente na primeira inicialização
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin

# ========================================
# MongoDB - Banco de Dados Inicial
# ========================================
# Nome do banco de dados que será inicializado
# Os scripts em init-db/ serão executados neste contexto
MONGO_INITDB_DATABASE=pokeAPI

# ========================================
# Porta do Serviço
# ========================================
# Porta do MongoDB (padrão: 27017)
MONGODB_PORT=27017

# ========================================
# Usuários da Aplicação (criados automaticamente)
# ========================================
# Estes usuários são criados pelos scripts de inicialização

# admin - Administrador com acesso total
# Credenciais: admin / admin

# viewer - Usuário somente leitura em pokemons
# Credenciais: viewer / viewPass123

# ========================================
# NOTAS DE SEGURANÇA
# ========================================
# ⚠️ Em produção, use senhas fortes e nunca exponha credenciais em repositórios públicos
# ⚠️ As senhas acima são apenas para desenvolvimento/demonstração
